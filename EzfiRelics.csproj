<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props" />
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    </PropertyGroup>

    <PropertyGroup>
        <DOTNET_HOST_PATH Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</DOTNET_HOST_PATH>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="False"> <!--Allows access to originally private/protected members but may (unlikely to) cause errors.-->
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="*" PrivateAssets="All" />
        <PackageReference Include="Krafs.Publicizer" Version="*" PrivateAssets="All" />
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />
        <!-- Generates a .pck file when building if only using simple assets. May not work on all setups. Uncomment to test. -->
        <PackageReference Include="BSchneppe.StS2.PckPacker" Version="*" PrivateAssets="All" />
        <AdditionalFiles Include="EzfiRelics/localization/**/*.json" /> <!-- Used by analyzer -->
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="EzfiRelics/**" />
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <EmbeddedResource Remove="EzfiRelics/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
    </ItemGroup>

    <ItemGroup>
        <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props" />
        <None Include=".gitignore" />
        <None Include="EzfiRelics.json" />
        <None Include="EzfiRelics\images\card_portraits\big\card.png" />
        <None Include="EzfiRelics\images\card_portraits\card.png" />
        <None Include="EzfiRelics\images\enchantments\bonded.png" />
        <None Include="EzfiRelics\images\enchantments\six_sided.png" />
        <None Include="EzfiRelics\images\powers\big\power.png" />
        <None Include="EzfiRelics\images\powers\power.png" />
        <None Include="EzfiRelics\images\relics\big\bloody_blade.png" />
        <None Include="EzfiRelics\images\relics\big\fax_machine.png" />
        <None Include="EzfiRelics\images\relics\big\grandfather_clock.png" />
        <None Include="EzfiRelics\images\relics\big\gun.png" />
        <None Include="EzfiRelics\images\relics\big\heavy_shield.png" />
        <None Include="EzfiRelics\images\relics\big\hole_in_one_club.png" />
        <None Include="EzfiRelics\images\relics\big\leaking_battery.png" />
        <None Include="EzfiRelics\images\relics\big\long_tooth.png" />
        <None Include="EzfiRelics\images\relics\big\lovely_locket.png" />
        <None Include="EzfiRelics\images\relics\big\overflowing_cup.png" />
        <None Include="EzfiRelics\images\relics\big\protein_powder.png" />
        <None Include="EzfiRelics\images\relics\big\scalpel.png" />
        <None Include="EzfiRelics\images\relics\big\snecko_dice.png" />
        <None Include="EzfiRelics\images\relics\big\vampire_dentures.png" />
        <None Include="EzfiRelics\images\relics\bloody_blade.png" />
        <None Include="EzfiRelics\images\relics\bloody_blade_outline.png" />
        <None Include="EzfiRelics\images\relics\fax_machine.png" />
        <None Include="EzfiRelics\images\relics\fax_machine_outline.png" />
        <None Include="EzfiRelics\images\relics\grandfather_clock.png" />
        <None Include="EzfiRelics\images\relics\grandfather_clock_outline.png" />
        <None Include="EzfiRelics\images\relics\gun.png" />
        <None Include="EzfiRelics\images\relics\gun_outline.png" />
        <None Include="EzfiRelics\images\relics\heavy_shield.png" />
        <None Include="EzfiRelics\images\relics\heavy_shield_outline.png" />
        <None Include="EzfiRelics\images\relics\hole_in_one_club.png" />
        <None Include="EzfiRelics\images\relics\hole_in_one_club_outline.png" />
        <None Include="EzfiRelics\images\relics\leaking_battery.png" />
        <None Include="EzfiRelics\images\relics\leaking_battery_outline.png" />
