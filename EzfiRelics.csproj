        <None Include="EzfiRelics\localization\eng\ancients.json" />
        <None Include="EzfiRelics\localization\eng\cards.json" />
        <None Include="EzfiRelics\localization\eng\card_keywords.json" />
        <None Include="EzfiRelics\localization\eng\enchantments.json" />
